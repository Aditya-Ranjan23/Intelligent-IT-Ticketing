# FastAPI Server Port
PORT=8000

# PostgreSQL Database Connection URI (defaults to local PostgreSQL or docker postgres service)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/it_ticketing

# Redis Server Connection URL
REDIS_URL=redis://localhost:6379/0

# ML Classification & Vector Caching Thresholds
CONFIDENCE_THRESHOLD=0.72
CACHE_SIMILARITY_THRESHOLD=0.82
STORE_PLAYBOOK_HITS=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Google Gemini API Key for Live RAG Deep Resolution
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
