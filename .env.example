# Required for deep-resolution path (Cursor SDK).
# Prefer passing explicitly in production services; this file is for local dev.
CURSOR_API_KEY=cursor_your_key_here

# Optional: override default model for local agents (see Cursor.models.list).
# CURSOR_MODEL_ID=composer-2

# API server port
PORT=3000

# Confidence threshold: below this, enqueue async SDK deep resolution (still returns <2s first response).
CONFIDENCE_THRESHOLD=0.72
