{
  "name": "it-ticket-auto-resolution",
  "version": "0.2.0",
  "private": true,
  "description": "ML in Python (ml/ + api/). Legacy Node/Cursor SDK optional under src/.",
  "scripts": {
    "ml:install": "pip install -r requirements.txt",
    "ml:serve": "python -m uvicorn api.main:app --host 127.0.0.1 --port 8000 --reload",
    "ml:eval": "python scripts/eval_ml.py",
    "ml:seed": "python scripts/seed_memory.py",
    "ml:demo": "python scripts/demo_api.py",
    "build": "echo \"Use Python ML: npm run ml:serve\"",
    "start": "npm run ml:serve"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  }
}
